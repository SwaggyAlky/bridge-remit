{
  "name": "bridge-remit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "python app.py",
    "test": "node --test tests/contracts.test.mjs",
    "demo": "node scripts/demo.mjs",
    "deploy:local": "node scripts/deploy.mjs",
    "deploy:sepolia": "node scripts/deploy.mjs --sepolia",
    "test:flask": "python -m unittest discover -s tests -p test_flask.py -v"
  },
  "dependencies": {
    "ethers": "6.15.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "ganache": "7.9.2",
    "solc": "0.8.30"
  }
}
